{
	"luci-app-homebox": {
		"description": "Grant access to control the homebox init service",
		"read": {
			"ubus": {
				"rc": ["list"],
				"service": ["list"],
				"uci": ["get", "configs", "state"]
			}
		},
		"write": {
			"ubus": {
				"rc": ["init"],
				"uci": ["set", "commit", "apply", "add", "delete", "reorder"]
			}
		}
	}
}
